# systemd unit for dispatch. Install with `make service-install` or:
#   sudo cp deploy/dispatch.service /etc/systemd/system/dispatch.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now dispatch
#
# Runs as the user that owns the Claude Code login (~/.claude). Edit User=,
# Group= and the paths below to match.
[Unit]
Description=dispatch — agent orchestration over Slack
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment=HOME=__HOME__
Environment=DISPATCH_CONFIG=__HOME__/.config/dispatch/config.toml
# claude is usually installed under ~/.local/bin
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__BIN__ run
# always, not on-failure: dispatch exits 0 on SIGTERM (it drains and shuts down
# cleanly), so a stray `pkill -f "dispatch run"` from an agent working on this repo
# looks like a successful exit and on-failure would leave the box down. An
# explicit `systemctl stop` is still honoured — systemd never restarts after one.
Restart=always
RestartSec=5
KillSignal=SIGTERM
# drain_timeout (default 2m) + margin: in-flight tool calls finish before stop
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
