# /etc/dispatch/deploy.env — what `make service-install` / `make update-install` were
# given. The updater reads this to re-render the unit files from the checkout, so a
# change to deploy/ lands on the box the same way a change to the Go code does.
#
# Written by make; edit via `make service-install VAR=...` rather than by hand.
# Values must be plain (no spaces or quotes): systemd reads this as an
# EnvironmentFile, and the updater sources it when run by hand.
DISPATCH_REPO=https://github.com/cleanunicorn/dispatch
DISPATCH_BRANCH=main
DISPATCH_SRC=/opt/dispatch/src
DISPATCH_BIN=/usr/local/bin/dispatch
DISPATCH_SERVICE=dispatch.service
DISPATCH_UPDATE_STATE=/var/lib/dispatch/deployed.sha
GO=/usr/bin/go
# substitutions for deploy/dispatch.service
DISPATCH_USER=dispatch
DISPATCH_GROUP=dispatch
DISPATCH_HOME=/home/dispatch
# substitutions for deploy/dispatch-update.{service,timer}
DISPATCH_INTERVAL=5min
DISPATCH_UPDATER=/usr/local/lib/dispatch/dispatch-update.sh
DISPATCH_UNIT=/etc/systemd/system/dispatch.service
DISPATCH_UPDATE_UNIT=/etc/systemd/system/dispatch-update.service
DISPATCH_UPDATE_TIMER=/etc/systemd/system/dispatch-update.timer
