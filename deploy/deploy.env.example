# /etc/dancer/deploy.env — what `make service-install` / `make update-install` were
# given. The updater reads this to re-render the unit files from the checkout, so a
# change to deploy/ lands on the box the same way a change to the Go code does.
#
# Written by make; edit via `make service-install VAR=...` rather than by hand.
# Values must be plain (no spaces or quotes): systemd reads this as an
# EnvironmentFile, and the updater sources it when run by hand.
DANCER_REPO=https://github.com/cleanunicorn/dancer
DANCER_BRANCH=main
DANCER_SRC=/opt/dancer/src
DANCER_BIN=/usr/local/bin/dancer
DANCER_SERVICE=dancer.service
DANCER_UPDATE_STATE=/var/lib/dancer/deployed.sha
GO=/usr/bin/go
# substitutions for deploy/dancer.service
DANCER_USER=dancer
DANCER_GROUP=dancer
DANCER_HOME=/home/dancer
# substitutions for deploy/dancer-update.{service,timer}
DANCER_INTERVAL=5min
DANCER_UPDATER=/usr/local/lib/dancer/dancer-update.sh
DANCER_UNIT=/etc/systemd/system/dancer.service
DANCER_UPDATE_UNIT=/etc/systemd/system/dancer-update.service
DANCER_UPDATE_TIMER=/etc/systemd/system/dancer-update.timer
